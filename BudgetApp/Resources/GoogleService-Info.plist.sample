<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample / redacted template. The real GoogleService-Info.plist is gitignored.

  To provision a dev machine:
    1. Download the iOS plist from Firebase Console → Project Settings → Your apps.
    2. Save as BudgetApp/Resources/GoogleService-Info.plist (same directory as this sample).
    3. Do not commit it — .gitignore already excludes it.

  CI reads the plist from the GS_INFO_B64 GitHub secret via scripts/decrypt-secrets.sh.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>API_KEY</key>
    <string>REDACTED</string>
    <key>GCM_SENDER_ID</key>
    <string>000000000000</string>
    <key>PLIST_VERSION</key>
    <string>1</string>
    <key>BUNDLE_ID</key>
    <string>com.budgetapp.app</string>
    <key>PROJECT_ID</key>
    <string>budgetapp-REDACTED</string>
    <key>STORAGE_BUCKET</key>
    <string>budgetapp-REDACTED.appspot.com</string>
    <key>IS_ADS_ENABLED</key>
    <false/>
    <key>IS_ANALYTICS_ENABLED</key>
    <false/>
    <key>IS_APPINVITE_ENABLED</key>
    <true/>
    <key>IS_GCM_ENABLED</key>
    <true/>
    <key>IS_SIGNIN_ENABLED</key>
    <true/>
    <key>GOOGLE_APP_ID</key>
    <string>1:000000000000:ios:REDACTED</string>
</dict>
</plist>
