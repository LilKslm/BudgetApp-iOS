rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — top-level user document (profile + quiz answers)
    match /users/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.id == uid;

      // User-scoped subcollections (budgets, transactions, etc.)
      // Rules are deliberately narrow here — only the authenticated owner
      // may read/write their own data. Subcollections are listed but empty
      // for Phase 3; they'll be populated in Phase 4 when the VMs land.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // sharedBudgets — denied for all in Phase 3; unlocked in Phase 5
    match /sharedBudgets/{id} {
      allow read, write: if false;
    }

    // Deny everything not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
